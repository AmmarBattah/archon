diff --git a/tasktracker/search.py b/tasktracker/search.py
index 2c7648a..eaad5f8 100644
--- a/tasktracker/search.py
+++ b/tasktracker/search.py
@@ -1,2 +1,32 @@
+import re
+
+from .models import DONE, OPEN
+
+TERM = re.compile(r'"([^"]*)"|(\S+)')
+
+
+class QueryError(ValueError):
+    pass
+
+
+def _terms(query):
+    if query.count('"') % 2:
+        raise QueryError(f"unterminated quote in {query!r}")
+    return [(m.group(1) is not None, m.group(1) if m.group(1) is not None else m.group(2))
+            for m in TERM.finditer(query)]
+
+
+def _matcher(quoted, term):
+    if not quoted and ":" in term:
+        field, value = term.split(":", 1)
+        if field == "tag":
+            return lambda t: value.lower() in (tag.lower() for tag in t.tags)
+        if field == "status" and value in (OPEN, DONE):
+            return lambda t: t.status == value
+        raise QueryError(f"unsupported term {term!r}")
+    return lambda t: term.lower() in t.title.lower()
+
+
 def search(tasks, query):
-    return [task for task in tasks if query in task.title]
+    matchers = [_matcher(quoted, term) for quoted, term in _terms(query)]
+    return [t for t in tasks if all(m(t) for m in matchers)]
