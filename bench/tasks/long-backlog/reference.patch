diff --git a/tests/test_backlog.py b/tests/test_backlog.py
new file mode 100644
index 0000000..fd88f2e
--- /dev/null
+++ b/tests/test_backlog.py
@@ -0,0 +1,36 @@
+import unittest
+from datetime import date
+
+from tasktracker.dates import InvalidDate, parse_due
+from tasktracker.export import to_csv
+from tasktracker.search import QueryError, search
+from tasktracker.store import NothingToUndo, TaskStore
+
+
+class BacklogTest(unittest.TestCase):
+    def test_impossible_date(self):
+        with self.assertRaises(InvalidDate):
+            parse_due("2026-02-30", date(2026, 1, 1))
+
+    def test_csv_quoting(self):
+        store = TaskStore()
+        store.add('a, "b"')
+        self.assertEqual(to_csv(store.all()), 'id,title,tags,status,due\r\n1,"a, ""b""",,open,\r\n')
+
+    def test_search_terms(self):
+        store = TaskStore()
+        store.add("Fix login", tags=["web"])
+        self.assertEqual(len(search(store.all(), '"fix login" tag:WEB status:open')), 1)
+        with self.assertRaises(QueryError):
+            search(store.all(), "owner:me")
+
+    def test_undo(self):
+        store = TaskStore()
+        store.add("a")
+        store.undo()
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+
+if __name__ == "__main__":
+    unittest.main()
